---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found" noindex>
  <section class="container-x grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="font-mono text-sm text-lime">404</p>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">This page took a wrong turn.</h1>
      <div class="mt-8 flex justify-center gap-3"><a href={u('/')} class="btn-primary">Go home</a><a href={u('/contact/')} class="btn-ghost">Contact us</a></div>
    </div>
  </section>
</Base>
