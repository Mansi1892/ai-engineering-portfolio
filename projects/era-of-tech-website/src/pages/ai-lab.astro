---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { aiProjects, aiProof } from '../data/site';
import { u } from '../lib/url';
const useCases = [
  { t: 'Website & WhatsApp chatbots', d: 'Answer FAQs, share prices and catalogues, book calls and hand over to a human: in English, Hindi or Arabic.' },
  { t: 'Lead scoring & CRM routing', d: 'Score every enquiry Hot / Warm / Cold, enrich it and route it to the right person on WhatsApp, email or your CRM.' },
  { t: 'Knowledge assistants (RAG)', d: 'Let your team or customers ask questions over your documents, policies and product data, with sources.' },
  { t: 'Agentic workflows', d: 'Research, drafting, reporting and follow-ups that run on a schedule, with approvals and guardrails built in.' },
];
---
<Base title="AI Lab: chatbots, automation & agentic workflows" description="Live AI demos by the Era of Tech team: Smart Meal AI, Lead Scoring Engine, ConsultFlow AI, Knoxx Outbound Intelligence and an AI customer-support chatbot.">
  <PageHero eyebrow="AI Lab" title="AI that does real work, <span class='text-lime'>with people in the loop.</span>" lead="Try the products and workflows our founders have built: live apps, n8n automations and agentic systems you can open right now.">
    <div class="mt-8 flex flex-wrap gap-3"><a href={u('/contact/?service=AI%20chatbot%20%2F%20automation')} class="btn-primary">Add AI to my business <Icon name="arrow" class="h-4 w-4" /></a></div>
  </PageHero>
  <section class="container-x py-16 sm:py-24">
    <div class="grid gap-5 lg:grid-cols-2">
      {aiProjects.map((a, i) => (
        <article class={`card flex flex-col p-7 sm:p-8 ${i === 0 ? 'lg:col-span-2 border-lime/50' : ''}`} data-reveal>
          <div class="flex flex-wrap items-center gap-2"><span class="chip !text-lime">{a.tag}</span><span class="chip">By {a.by}</span></div>
          <h2 class="mt-5 text-2xl font-semibold">{a.name}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-soft">{a.desc}</p>
          <div class="mt-5 flex flex-wrap gap-2">{a.stack.map((s) => <span class="chip">{s}</span>)}</div>
          <div class="mt-auto flex flex-wrap gap-3 pt-7">{a.links.map((l, j) => <a href={l.url} target="_blank" rel="noopener" class={j === 0 ? 'btn-primary !py-2.5' : 'btn-ghost !py-2.5'}>{l.label}<Icon name="ext" class="h-4 w-4" /></a>)}</div>
        </article>
      ))}
    </div>
  </section>
  <section class="border-t border-line bg-coal/40 py-16 sm:py-24">
    <div class="container-x">
      <SectionHead eyebrow="What we can build for you" title="Four ways AI pays for itself." />
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {useCases.map((c) => <div class="card p-6" data-reveal><Icon name="spark" class="h-5 w-5 text-lime" /><h3 class="mt-4 text-lg font-semibold">{c.t}</h3><p class="mt-2 text-sm leading-relaxed text-soft">{c.d}</p></div>)}
      </div>
      <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4" data-reveal>
        {aiProof.map((x) => <div class="bg-coal p-6"><p class="font-display text-2xl font-semibold text-white">{x.value}</p><p class="mt-1 text-xs leading-snug text-mute">{x.label}</p></div>)}
      </div>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-wider text-mute">Team track record at previous companies (SentiSum, Lenskart, The Media Ant)</p>
    </div>
  </section>
  <FinalCta />
</Base>
