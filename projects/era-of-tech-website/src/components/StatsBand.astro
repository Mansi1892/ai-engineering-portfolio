---
import { stats } from '../data/site';
// NOTE: every value comes from src/data/site.ts and is a PLACEHOLDER until replaced.
---
<section aria-label="Studio in numbers" class="border-y border-line bg-coal">
  <div class="container-x grid grid-cols-2 gap-px overflow-hidden md:grid-cols-4">
    {stats.map((s, i) => (
      <div class="px-2 py-8 sm:px-6" data-reveal style={`transition-delay:${(i % 4) * 70}ms`}>
        <p class="font-display text-3xl font-semibold text-white sm:text-4xl">{s.value}</p>
        <p class="mt-2 text-xs leading-snug text-mute sm:text-sm">{s.label}</p>
      </div>
    ))}
  </div>
</section>
