---
import { process } from '../data/site';
---
<ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-5">
  {process.map((s, i) => (
    <li class="relative bg-coal p-6" data-reveal style={`transition-delay:${i * 80}ms`}>
      <p class="font-mono text-xs text-lime">{s.step}</p>
      <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
      <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-mute">{s.time}</p>
      <p class="mt-3 text-sm leading-relaxed text-soft">{s.desc}</p>
    </li>
  ))}
</ol>
