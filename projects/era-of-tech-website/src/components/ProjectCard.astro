---
import type { Project } from '../data/site';
import Icon from './Icon.astro';
import { u } from '../lib/url';
interface Props { p: Project; size?: 'lg' | 'sm'; eager?: boolean; level?: 'h2' | 'h3' }
const { p, size = 'lg', eager = false, level = 'h3' } = Astro.props;
const H = level;
---
<a href={u(`/work/${p.slug}/`)} class="group block" data-reveal>
  <div class="relative overflow-hidden rounded-2xl border border-line bg-char">
    <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span><span class="h-2.5 w-2.5 rounded-full bg-line"></span>
      <span class="ml-3 truncate font-mono text-[11px] text-mute">{p.urlLabel}</span>
    </div>
    <img src={u(`/images/work/${p.slug}-800.webp`)} srcset={`${u(`/images/work/${p.slug}-800.webp`)} 800w, ${u(`/images/work/${p.slug}.webp`)} 1440w`}
      sizes={size === 'lg' ? '(min-width:1024px) 50vw, 100vw' : '(min-width:1024px) 33vw, 100vw'}
      width="800" height="500" alt={`${p.name} website homepage designed and built by Era of Tech`}
      loading={eager ? 'eager' : 'lazy'} decoding="async"
      class="aspect-[16/10] w-full object-cover object-top transition duration-700 group-hover:scale-[1.03]" />
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <span class="chip">{p.flag} {p.country}</span><span class="chip">{p.industry}</span><span class="chip">{p.platform}</span>
  </div>
  <H class={`mt-3 font-semibold ${size === 'lg' ? 'text-2xl' : 'text-xl'}`}>{p.name}</H>
  <p class="mt-1.5 text-sm leading-relaxed text-soft">{p.hook}</p>
  <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-lime">View case study <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" /></span>
</a>
