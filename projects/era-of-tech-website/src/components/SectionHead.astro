---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; as?: 'h1' | 'h2' }
const { eyebrow, title, lead, center = false, as = 'h2' } = Astro.props;
const Tag = as;
---
<div class={`max-w-3xl ${center ? 'mx-auto text-center' : ''}`} data-reveal>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Tag class={as === 'h1' ? 'text-4xl font-semibold leading-[1.08] sm:text-5xl lg:text-6xl' : 'h-section leading-tight'} set:html={title} />
  {lead && <p class="lead mt-5">{lead}</p>}
</div>
