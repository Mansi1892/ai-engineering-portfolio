---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { waLink } from '../lib/url';
---
<a href={waLink()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" data-track="whatsapp-float"
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#25D366] p-3.5 text-ink shadow-[0_10px_30px_-5px_rgba(37,211,102,.5)] transition hover:-translate-y-0.5 sm:bottom-6 sm:right-6">
  <WhatsAppIcon class="h-6 w-6" />
  <span class="hidden pr-1 text-sm font-semibold sm:inline">Chat on WhatsApp</span>
</a>
