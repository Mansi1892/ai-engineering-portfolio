---
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import Icon from './Icon.astro';
import { brand, contact, sister, projects, services } from '../data/site';
import { u, waLink } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-coal">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-mute">{brand.description}</p>
      <div class="mt-6 flex flex-col gap-2 text-sm">
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 text-soft hover:text-lime"><Icon name="mail" class="h-4 w-4" />{contact.email}</a>
        <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-soft hover:text-lime"><WhatsAppIcon class="h-4 w-4" />{contact.whatsappDisplay}</a>
        <p class="font-mono text-xs uppercase tracking-wider text-mute">{contact.locations.join(' · ')}</p>
      </div>
    </div>
    <div class="md:col-span-2">
      <p class="label">Services</p>
      <ul class="space-y-2 text-sm">{services.map((s) => <li><a class="text-soft hover:text-white" href={u(`/services/#${s.id}`)}>{s.title}</a></li>)}</ul>
    </div>
    <div class="md:col-span-2">
      <p class="label">Work</p>
      <ul class="space-y-2 text-sm">{projects.map((p) => <li><a class="text-soft hover:text-white" href={u(`/work/${p.slug}/`)}>{p.name}</a></li>)}</ul>
    </div>
    <div class="md:col-span-2">
      <p class="label">Studio</p>
      <ul class="space-y-2 text-sm">
        {[['AI Lab','/ai-lab/'],['Pricing','/pricing/'],['Process','/process/'],['About','/about/'],['FAQ','/faq/'],['Contact','/contact/'],['Privacy','/privacy/']].map(([l,h]) => <li><a class="text-soft hover:text-white" href={u(h)}>{l}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="label">Growth partner</p>
      <a href={sister.url} target="_blank" rel="noopener" class="group block rounded-xl border border-line p-4 transition hover:border-lime">
        <span class="font-display text-white">{sister.name}</span>
        <span class="mt-1 block text-xs text-mute">{sister.pitch}</span>
        <span class="mt-3 inline-flex items-center gap-1 text-xs text-lime">eraofmarketing.com <Icon name="ext" class="h-3.5 w-3.5" /></span>
      </a>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-mute sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {brand.name}. A sister studio of {sister.name}.</p>
      <p class="font-mono">Built by us · Static & fast · <a class="hover:text-white" href={u('/sitemap-index.xml')}>Sitemap</a></p>
    </div>
  </div>
</footer>
