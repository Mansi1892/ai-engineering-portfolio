---
import { whyUs } from '../data/site';
---
<div class="grid gap-5 sm:grid-cols-2">
  {whyUs.map((w, i) => (
    <div class="card p-7" data-reveal style={`transition-delay:${(i % 2) * 80}ms`}>
      <p class="font-mono text-xs text-lime">0{i + 1}</p>
      <h3 class="mt-3 text-xl font-semibold">{w.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-soft">{w.desc}</p>
    </div>
  ))}
</div>
