---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="relative overflow-hidden border-b border-line">
  <div class="grid-bg pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
  <div class="container-x relative py-16 sm:py-24">
    <p class="eyebrow mb-4">{eyebrow}</p>
    <h1 class="max-w-4xl text-4xl font-semibold leading-[1.08] sm:text-5xl lg:text-6xl" set:html={title} />
    {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
    <slot />
  </div>
</section>
